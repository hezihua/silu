{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- ':(exclude)README.md' ':(exclude).github'",
  "regions": ["hnd1"],
  "cleanUrls": true,
  "trailingSlash": false
}
